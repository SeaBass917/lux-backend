# ====================================================================
# Stage 1: builder (Installs all dependencies and compiles packages)
# ====================================================================
FROM python:3.12-slim as builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    build-essential \
    python3-dev \
    pkg-config \
    --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY ./server/requirements.frozen.txt /app/
RUN pip install --no-cache-dir -r requirements.frozen.txt

# ====================================================================
# Stage 2: runtime (Minimal production image)
# ====================================================================
FROM python:3.12-slim AS runtime

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    gunicorn \
    --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -U -u 1000 appuser
RUN mkdir /app && chown -R appuser:appuser /app

# Copy virtual environment from builder
COPY --from=builder --chown=appuser:appuser /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Set up user and working directories
USER appuser
WORKDIR /app/lux

# Copy application code (no volume mounts in production)
COPY --chown=appuser:appuser ./server /app/lux/

# Create media directory
RUN mkdir -p /app/media

# Application port
EXPOSE 8000

# Production command with more workers
CMD ["gunicorn", "lux.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "4", "--threads", "2", "--timeout", "60"]
