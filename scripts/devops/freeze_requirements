#!/bin/bash
set -e

# Script to freeze requirements with a clean virtual environment

PROJECT_ROOT=$(pwd)
VENV_PATH="$PROJECT_ROOT/.venv"
SERVER_DIR="$PROJECT_ROOT/server"

# If the `.venv`` is not here we are probably not in the right spot to be running this...
# This is meant to be a utility not a setup.
if [ ! -d "$VENV_PATH" ]; then
  echo "Error: Virtual environment not found at $VENV_PATH"
  echo "Please run this script from the project root where .venv is located."
  exit 1
fi

echo "[1/6] Cleaning virtual environment..."
deactivate 2>/dev/null || true
rm -rf "$VENV_PATH"

echo "[2/6] Creating fresh virtual environment..."
python3 -m venv "$VENV_PATH"
source "$VENV_PATH/bin/activate"

echo "[3/6] Installing production dependencies..."
pip install --upgrade pip
pip install -r "$SERVER_DIR/requirements.txt"

echo "[4/6] Freezing production dependencies..."
pip freeze > "$SERVER_DIR/requirements.frozen.txt"
echo "Wrote $SERVER_DIR/requirements.frozen.txt"

echo "[5/6] Installing dev dependencies..."
pip install -r "$SERVER_DIR/requirements.dev.txt"

echo "[6/6] Freezing dev dependencies..."
pip freeze > "$SERVER_DIR/requirements.dev.frozen.txt"
echo "Wrote $SERVER_DIR/requirements.dev.frozen.txt"

echo ""
echo "Done! Virtual environment is ready with dev dependencies installed."
echo "   Run: source .venv/bin/activate"
